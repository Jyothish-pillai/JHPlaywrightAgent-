{
	"servers": {
		"playwright": {
			"type": "stdio",
			"command": "${workspaceFolder}\\node_modules\\.bin\\playwright-mcp-server.cmd",
			"args": []
		},
		"playwright-test": {
			"type": "stdio",
			"command": "${workspaceFolder}\\node_modules\\.bin\\playwright.cmd",
			"args": [
				"run-test-mcp-server"
			]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${input:github_mcp_pat}"
			}
		}
	},
	"inputs": []
}